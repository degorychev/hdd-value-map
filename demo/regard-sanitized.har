\u0434\\u0435\\u043b\\u0430\\u044e\\u0442 \\u0435\\u0433\\u043e \\u0443\\u0434\\u043e\\u0431\\u043d\\u044b\\u043c \\u0434\\u043b\\u044f \\u0438\\u0441\\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u0432 \\u0434\\u043e\\u043c\\u0430\\u0448\\u043d\\u0438\\u0445 \\u0443\\u0441\\u043b\\u043e\\u0432\\u0438\\u044f\\u0445, \\u0433\\u0434\\u0435 \\u0442\\u0438\\u0448\\u0438\\u043d\\u0430 \\u0438 \\u043a\\u043e\\u043c\\u0444\\u043e\\u0440\\u0442 \\u0438\\u043c\\u0435\\u044e\\u0442 \\u0437\\u043d\\u0430\\u0447\\u0435\\u043d\\u0438\\u0435.  <br \\/>\\n<br \\/>\\n\\u0414\\u043e\\u043b\\u0433\\u043e\\u0432\\u0435\\u0447\\u043d\\u043e\\u0441\\u0442\\u044c \\u0436\\u0451\\u0441\\u0442\\u043a\\u043e\\u0433\\u043e \\u0434\\u0438\\u0441\\u043a\\u0430 \\u043f\\u043e\\u0434\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0430\\u0435\\u0442\\u0441\\u044f \\u043f\\u0440\\u043e\\u0434\\u0432\\u0438\\u043d\\u0443\\u0442\\u044b\\u043c\\u0438 \\u0442\\u0435\\u0445\\u043d\\u043e\\u043b\\u043e\\u0433\\u0438\\u044f\\u043c\\u0438 \\u043a\\u043e\\u043d\\u0442\\u0440\\u043e\\u043b\\u044f \\u043e\\u0448\\u0438\\u0431\\u043e\\u043a \\u0438 \\u0437\\u0430\\u0449\\u0438\\u0442\\u044b \\u0434\\u0430\\u043d\\u043d\\u044b\\u0445. \\u0412\\u0441\\u0442\\u0440\\u043e\\u0435\\u043d\\u043d\\u044b\\u0435 \\u043c\\u0435\\u0445\\u0430\\u043d\\u0438\\u0437\\u043c\\u044b \\u0441\\u0430\\u043c\\u043e\\u0434\\u0438\\u0430\\u0433\\u043d\\u043e\\u0441\\u0442\\u0438\\u043a\\u0438 \\u0438 \\u043a\\u043e\\u0440\\u0440\\u0435\\u043a\\u0446\\u0438\\u0438 \\u043f\\u0440\\u0435\\u0434\\u043e\\u0442\\u0432\\u0440\\u0430\\u0449\\u0430\\u044e\\u0442 \\u043f\\u043e\\u0442\\u0435\\u0440\\u044e \\u0438\\u043d\\u0444\\u043e\\u0440\\u043c\\u0430\\u0446\\u0438\\u0438, \\u0430 \\u0432\\u044b\\u0441\\u043e\\u043a\\u0430\\u044f \\u043d\\u0430\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0430 \\u043d\\u0430 \\u043e\\u0442\\u043a\\u0430\\u0437 (MTBF) \\u0433\\u0430\\u0440\\u0430\\u043d\\u0442\\u0438\\u0440\\u0