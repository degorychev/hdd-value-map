\\u043d\\u0430\\u044f \\u0441\\u043f\\u043e\\u0441\\u043e\\u0431\\u043d\\u043e\\u0441\\u0442\\u044c \\u043a\\u0430\\u043d\\u0430\\u043b\\u0430 \\u0434\\u043e\\u0441\\u0442\\u0438\\u0433\\u0430\\u0435\\u0442 6 \\u0433\\u0438\\u0433\\u0430\\u0431\\u0438\\u0442 \\u0432 \\u0441\\u0435\\u043a\\u0443\\u043d\\u0434\\u0443, \\u0447\\u0442\\u043e \\u043e\\u0431\\u0435\\u0441\\u043f\\u0435\\u0447\\u0438\\u0432\\u0430\\u0435\\u0442 \\u0431\\u044b\\u0441\\u0442\\u0440\\u044b\\u0439 \\u043e\\u0431\\u043c\\u0435\\u043d \\u0434\\u0430\\u043d\\u043d\\u044b\\u043c\\u0438 \\u0441 \\u043c\\u0430\\u0442\\u0435\\u0440\\u0438\\u043d\\u0441\\u043a\\u043e\\u0439 \\u043f\\u043b\\u0430\\u0442\\u043e\\u0439 \\u0438 \\u0438\\u0441\\u043a\\u043b\\u044e\\u0447\\u0430\\u0435\\u0442 \\u0432\\u043e\\u0437\\u043d\\u0438\\u043a\\u043d\\u043e\\u0432\\u0435\\u043d\\u0438\\u0435 \\u0443\\u0437\\u043a\\u0438\\u0445 \\u043c\\u0435\\u0441\\u0442 \\u043f\\u0440\\u0438 \\u043f\\u0435\\u0440\\u0435\\u0434\\u0430\\u0447\\u0435 \\u0431\\u043e\\u043b\\u044c\\u0448\\u0438\\u0445 \\u0444\\u0430\\u0439\\u043b\\u043e\\u0432.<br \\/>\\n<br \\/>\\n\\u041a\\u043b\\u044e\\u0447\\u0435\\u0432\\u044b\\u043c \\u043f\\u0440\\u0435\\u0438\\u043c\\u0443\\u0449\\u0435\\u0441\\u0442\\u0432\\u043e\\u043c \\u0434\\u0430\\u043d\\u043d\\u043e\\u0439 \\u043c\\u043e\\u0434\\u0435\\u043b\\u0438 \\u044f\\u0432\\u043b\\u044f\\u0435\\u0442\\u0441\\u044f \\u0441\\u043a\\u043e\\u0440\\u043e\\u0441\\u0442\\u044c \\u0432\\u0440\\u0430\\u0449\\u0435\\u043d\\u0438\\u044f \\u0448\\u043f\\u0438\\u043d\\u0434\\u0435\\u043b\\u044f 7200 \\u043e\\u0431\\u043e\\u0440\\u043e\\u0442\\u043e\\u0432 \\u0432 \\u043c\\u0438\\u043d\\u0443\\u0442\\u0443. \\u0414\\u043b\\u044f \\u0441\\u0435\\u0440\\u0432\\u0435\\u0440\\u043d\\u043e\\u0433\\u043e \\u0441\\u0435\\u0433\\u043c\\u0435\\u043d\\u0442\\u0430 \\u044d\\u0442\\u043e \\u0437\\u043e\\u043b\\u043e\\u0442\\u043e\\u0439 \\u0441\\u0442\\u0430\\u043d\\u0434\\u0430\\u0440\\u0442, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0439 \\u0433\\u0430\\u0440\\u0430\\u043d\\u0442\\u0438\\u0440\\u0443\\u0435\\u0442 \\u043d\\u0438\\u0437\\u043a\\u043e\\u0435 \\u0432\\u0440\\u0435\\u043c\\u044f \\u0434\\u043e\\u0441\\u0442\\u0443\\u043f\\u0430 \\u043a \\u0434\\u0430\\u043d\\u043d\\u044b\\u043c \\u0438 \\u0441\\u0442\\u0430\\u0431\\u0438\\u043b\\u044c\\u043d\\u0443\\u044e \\u0441\\u043a\\u043e\\u0440\\u043e\\u0441\\u0442\\u044c \\u043f\\u043e\\u0441\\u043b\\u0435\\u0434\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e \\u0447\\u0442\\u0435\\u043d\\u0438\\u044f \\u0438 \\u0437\\u0430\\u043f\\u0438\\u0441\\u0438. \\u0412 \\u0441\\u043e\\u0447\\u0435\\u0442\\u0430\\u043d\\u0438\\u0438 \\u0441 \\u043e\\u0431\\u044a\\u0451\\u043c\\u043e\\u043c \\u0431\\u0443\\u0444\\u0435\\u0440\\u043d\\u043e\\u0439 \\u043f\\u0430\\u043c\\u044f\\u0442\\u0438 128 \\u043c\\u0435\\u0433\\u0430\\u0431\\u0430\\u0439\\u0442, \\u043d\\u0430\\u043a\\u043e\\u043f\\u0438\\u0442\\u0435\\u043b\\u044c \\u044d\\u0444\\u0444\\u0435\\u043a\\u0442\\u0438\\u0432\\u043d\\u043e \\u0441\\u0433\\u043b\\u0430\\u0436\\u0438\\u0432\\u0430\\u0435\\u0442 \\u043f\\u0438\\u043a\\u043e\\u0432\\u044b\\u0435 \\u043d\\u0430\\u0433\\u0440\\u0443\\u0437\\u043a\\u0438, \\u0443\\u0441\\u043a\\u043e\\u0440\\u044f\\u044f \\u043e\\u0431\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0443 \\u043f\\u043e\\u0432\\u0442\\u043e\\u0440\\u044f\\u044e\\u0449\\u0438\\u0445\\u0441\\u044f \\u0437\\u0430\\u043f\\u0440\\u043e\\u0441\\u043e\\u0432. \\u0422\\u0430\\u043a\\u0430\\u044f \\u043a\\u043e\\u043d\\u0444\\u0438\\u0433\\u0443\\u0440\\u0430\\u0446\\u0438\\u044f \\u0434\\u0435\\u043b\\u0430\\u0435\\u0442 Seagate Exos 7E8 \\u0438\\u0434\\u0435\\u0430\\u043b\\u044c\\u043d\\u044b\\u043c \\u0432\\u044b\\u0431\\u043e\\u0440\\u043e\\u043c \\u0434\\u043b\\u044f \\u0441\\u0438\\u0441\\u0442\\u0435\\u043c, \\u0433\\u0434\\u0435 \\u0432\\u0430\\u0436\\u043d\\u0430 \\u043a\\u0430\\u0436\\u0434\\u0430\\u044f \\u043c\\u0438\\u043b\\u043b\\u0438\\u0441\\u0435\\u043a\\u0443\\u043d\\u0434\\u0430, \\u2014 \\u043e\\u0442 \\u0444\\u0430\\u0439\\u043b\\u043e\\u0432\\u044b\\u0445 \\u0445\\u0440\\u0430\\u043d\\u0438\\u043b\\u0438\\u0449 \\u0434\\u043e \\u0441\\u0438\\u0441\\u0442\\u0435\\u043c \\u0432\\u0438\\u0434\\u0435\\u043e\\u043d\\u0430\\u0431\\u043b\\u044e\\u0434\\u0435\\u043d\\u0438\\u044f \\u0441 \\u0432\\u044b\\u0441\\u043e\\u043a\\u0438\\u043c \\u0440\\u0430\\u0437\\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435\\u043c.<br \\/>\\n<br \\/>\\n\\u041d\\u0430\\u0434\\u0451\\u0436\\u043d\\u043e\\u0441\\u0442\\u044c, \\u0437\\u0430\\u043b\\u043e\\u0436\\u0435\\u043d\\u043d\\u0430\\u044f \\u0432 \\u043a\\u043e\\u043d\\u0441\\u0442\\u0440\\u0443\\u043a\\u0446\\u0438\\u044e, \\u0437\\u0430\\u0441\\u043b\\u0443\\u0436\\u0438\\u0432\\u0430\\u0435\\u0442 \\u043e\\u0442\\u0434\\u0435\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e \\u0432\\u043d\\u0438\\u043c\\u0430\\u043d\\u0438\\u044f. \\u041d\\u0430\\u0437\\u043d\\u0430\\u0447\\u0435\\u043d\\u0438\\u0435 \\u00ab\\u0446\\u0435\\u043d\\u0442\\u0440\\u044b \\u043e\\u0431\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0438 \\u0434\\u0430\\u043d\\u043d\\u044b\\u0445\\u00bb \\u043f\\u043e\\u0434\\u0440\\u0430\\u0437\\u0443\\u043c\\u0435\\u0432\\u0430\\u0435\\u0442 \\u0436\\u0451\\u0441\\u0442\\u043a\\u0438\\u0435 \\u0442\\u0440\\u0435\\u0431\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u043a \\u0440\\u0435\\u0441\\u0443\\u0440\\u0441\\u0443 \\u0440\\u0430\\u0431\\u043e\\u0442\\u044b. \\u0414\\u0430\\u043d\\u043d\\u044b\\u0439 \\u043d\\u0430\\u043a\\u043e\\u043f\\u0438\\u0442\\u0435\\u043b\\u044c \\u0441\\u043f\\u0440\\u043e\\u0435\\u043a\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d \\u0434\\u043b\\u044f \\u0440\\u0430\\u0431\\u043e\\u0442\\u044b \\u0432 \\u0443\\u0441\\u043b\\u043e\\u0432\\u0438\\u044f\\u0445 \\u043f\\u043e\\u0441\\u0442\\u043e\\u044f\\u043d\\u043d\\u043e\\u0439 \\u0432\\u0438\\u0431\\u0440\\u0430\\u0446\\u0438\\u0438 \\u0438 \\u0432\\u044b\\u0441\\u043e\\u043a\\u0438\\u0445 \\u0442\\u0435\\u043c\\u043f\\u0435\\u0440\\u0430\\u0442\\u0443\\u0440, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0435 \\u043d\\u0435\\u0438\\u0437\\u0431\\u0435\\u0436\\u043d\\u044b \\u0432 \\u0441\\u0435\\u0440\\u0432\\u0435\\u0440\\u043d\\u044b\\u0445 \\u0441\\u0442\\u043e\\u0439\\u043a\\u0430\\u0445. \\u0418\\u043d\\u0436\\u0435\\u043d\\u0435\\u0440\\u044b Seagate \\u0440\\u0435\\u0430\\u043b\\u0438\\u0437\\u043e\\u0432\\u0430\\u043b\\u0438 \\u0432 \\u044d\\u0442\\u043e\\u0439 \\u0441\\u0435\\u0440\\u0438\\u0438 \\u0442\\u0435\\u0445\\u043d\\u043e\\u043b\\u043e\\u0433\\u0438\\u0438 \\u0437\\u0430\\u0449\\u0438\\u0442\\u044b \\u043e\\u0442 \\u043f\\u043e\\u0442\\u0435\\u0440\\u0438 \\u0434\\u0430\\u043d\\u043d\\u044b\\u0445 \\u043f\\u0440\\u0438 \\u043d\\u0435\\u043e\\u0436\\u0438\\u0434\\u0430\\u043d\\u043d\\u044b\\u0445 \\u0441\\u0431\\u043e\\u044f\\u0445 \\u043f\\u0438\\u0442\\u0430\\u043d\\u0438\\u044f \\u0438 \\u0443\\u0441\\u043e\\u0432\\u0435\\u0440\\u0448\\u0435\\u043d\\u0441\\u0442\\u0432\\u043e\\u0432\\u0430\\u043d\\u043d\\u044b\\u0435 \\u0430\\u043b\\u0433\\u043e\\u0440\\u0438\\u0442\\u043c\\u044b \\u043a\\u043e\\u0440\\u0440\\u0435\\u043a\\u0446\\u0438\\u0438 \\u043e\\u0448\\u0438\\u0431\\u043e\\u043a. \\u042d\\u0442\\u043e \\u043d\\u0435 \\u043f\\u0440\\u043e\\u0441\\u0442\\u043e \\u0443\\u0441\\u0442\\u0440\\u043e\\u0439\\u0441\\u0442\\u0432\\u043e \\u0434\\u043b\\u044f \\u0445\\u0440\\u0430\\u043d\\u0435\\u043d\\u0438\\u044f, \\u0430 \\u0433\\u0430\\u0440\\u0430\\u043d\\u0442\\u0438\\u044f \\u0441\\u043e\\u0445\\u0440\\u0430\\u043d\\u043d\\u043e\\u0441\\u0442\\u0438 \\u0432\\u0430\\u0448\\u0435\\u0439 \\u0438\\u043d\\u0444\\u043e\\u0440\\u043c\\u0430\\u0446\\u0438\\u0438 \\u043f\\u0440\\u0438 \\u0441\\u0430\\u043c\\u044b\\u0445 \\u044d\\u043a\\u0441\\u0442\\u0440\\u0435\\u043c\\u0430\\u043b\\u044c\\u043d\\u044b\\u0445 \\u0441\\u0446\\u0435\\u043d\\u0430\\u0440\\u0438\\u044f\\u0445 \\u044d\\u043a\\u0441\\u043f\\u043b\\u0443\