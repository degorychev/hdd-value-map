\u043d\\u0430 \\u0434\\u0430\\u043d\\u043d\\u044b\\u0445 \\u0434\\u043e 6 \\u0413\\u0431\\u043e\\u0434. \\u041f\\u0440\\u0438\\u0441\\u043c\\u043e\\u0442\\u0440\\u0435\\u0432\\u0448\\u0438\\u0441\\u044c \\u043a \\u044d\\u0442\\u043e\\u0439 \\u043c\\u043e\\u0434\\u0435\\u043b\\u0438, \\u0432\\u044b \\u0432\\u0441\\u0435\\u0433\\u0434\\u0430 \\u0441\\u043c\\u043e\\u0436\\u0435\\u0442\\u0435 \\u0440\\u0430\\u0441\\u0448\\u0438\\u0440\\u0438\\u0442\\u044c \\u0451\\u043c\\u043a\\u043e\\u0441\\u0442\\u044c \\u0441\\u0432\\u043e\\u0435\\u0433\\u043e \\u0434\\u0430\\u0442\\u0430-\\u0446\\u0435\\u043d\\u0442\\u0440\\u0430 \\u0431\\u0435\\u0437 \\u0437\\u0430\\u043c\\u0435\\u043d\\u044b \\u044e\\u043d\\u0438\\u0442\\u043e\\u0432. \\u0421\\u0442\\u0435\\u043a\\u043b\\u043e \\u043d\\u0430\\u043a\\u043e\\u043f\\u0438\\u0442\\u0435\\u043b\\u044f \\u0438 \\u043f\\u043e\\u0434\\u0448\\u0438\\u043f\\u043d\\u0438\\u043a\\u0438 \\u0441\\u043e \\u0441\\u0442\\u0430\\u0431\\u0438\\u043b\\u0438\\u0437\\u0430\\u0446\\u0438\\u0435\\u0439 \\u043f\\u0440\\u0435\\u0434\\u043e\\u0442\\u0432\\u0440\\u0430\\u0449\\u0430\\u044e\\u0442 \\u043f\\u043e\\u044f\\u0432\\u043b\\u0435\\u043d\\u0438\\u0435 \\u0431\\u0438\\u0442\\u044b\\u0445 \\u0441\\u0435\\u043a\\u0442\\u043e\\u0440\\u043e\\u0432, \\u043a \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u043c \\u0447\\u0443\\u0432\\u0441\\u0442\\u0432\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u044b \\u0443\\u0434\\u0430\\u043b\\u0451\\u043d\\u043d\\u044b\\u0435 \\u0430\\u0440\\u0445\\u0438\\u0432\\u044b.<br \\/>\\n<br \\/>\\n\\u041c\\u043e\\u0434\\u0435\\u043b\\u044c \\u044d\\u0442\\u043e\\u0439 \\u0441\\u0435\\u0440\\u0438\\u0438 \\u043e\\u0441\\u043d\\u043e\\u0432\\u0430\\u043d\\u0430 \\u043d\\u0430 \\u0432\\u0440\\u043e\\u0436\\u0434\\u0435\\u043d\\u043d\\u043e\\u0439 \\u0432\\u044b\\u043d\\u043e\\u0441\\u043b\\u0438\\u0432\\u043e\\u0441\\u0442\\u0438. \\u0412\\u044b\\u0432\\u0435\\u0441\\u0442\\u0438 \\u0442\\u0430\\u043a\\u043e\\u0439 \\u0436\\u0451\\u0