0445. \\u0415\\u0433\\u043e \\u0451\\u043c\\u043a\\u043e\\u0441\\u0442\\u0438 \\u0432 12 \\u0442\\u0435\\u0440\\u0430\\u0431\\u0430\\u0439\\u0442 \\u0434\\u043e\\u0441\\u0442\\u0430\\u0442\\u043e\\u0447\\u043d\\u043e \\u0434\\u043b\\u044f \\u0445\\u0440\\u0430\\u043d\\u0435\\u043d\\u0438\\u044f \\u043e\\u0433\\u0440\\u043e\\u043c\\u043d\\u044b\\u0445 \\u0430\\u0440\\u0445\\u0438\\u0432\\u043e\\u0432, \\u0440\\u0435\\u0437\\u0435\\u0440\\u0432\\u043d\\u044b\\u0445 \\u043a\\u043e\\u043f\\u0438\\u0439, \\u043c\\u0435\\u0434\\u0438\\u0430\\u0442\\u0435\\u043a\\u0438 \\u0432\\u044b\\u0441\\u043e\\u043a\\u043e\\u0433\\u043e \\u0440\\u0430\\u0437\\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u044f \\u0438\\u043b\\u0438 \\u0440\\u0430\\u0437\\u0432\\u0435\\u0440\\u043d\\u0443\\u0442\\u044b\\u0445 \\u0432\\u0438\\u0440\\u0442\\u0443\\u0430\\u043b\\u044c\\u043d\\u044b\\u0445 \\u0441\\u0440\\u0435\\u0434. \\u042d\\u0442\\u043e \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u0434\\u043b\\u044f \\u0442\\u0435\\u0445, \\u043a\\u0442\\u043e \\u0446\\u0435\\u043d\\u0438\\u0442 \\u043d\\u0435 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043e\\u0431\\u044a\\u0451\\u043c, \\u043d\\u043e \\u0438 \\u0443\\u0432\\u0435\\u0440\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c \\u0432 \\u0442\\u043e\\u043c, \\u0447\\u0442\\u043e \\u043a\\u0430\\u0436\\u0434\\u044b\\u0439 \\u0431\\u0430\\u0439\\u0442 \\u0438\\u043d\\u0444\\u043e\\u0440\\u043c\\u0430\\u0446\\u0438\\u0438 \\u0431\\u0443\\u0434\\u0435\\u0442 \\u0437\\u0430\\u0449\\u0438\\u0449\\u0451\\u043d. \\u0414\\u0438\\u0441\\u043a \\u0441\\u0442\\u0430\\u043d\\u043e\\u0432\\u0438\\u0442\\u0441\\u044f \\u043d\\u0435\\u0437\\u0430\\u043c\\u0435\\u043d\\u0438\\u043c\\u044b\\u043c \\u044d\\u043b\\u0435\\u043c\\u0435\\u043d\\u0442\\u043e\\u043c \\u0432 \\u043f\\u043e\\u0441\\u0442\\u0440\\u043e\\u0435\\u043d\\u0438\\u0438 \\u043c\\u0430\\u0441\\u0448\\u0442\\u0430\\u0431\\u0438\\u0440\\u0443\\u0435\\u043c\\u044b\\u0445, \\u044d\\u0444\\u044