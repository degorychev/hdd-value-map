42\\u043a\\u0438 \\u0438 \\u0443\\u0434\\u0430\\u043b\\u0435\\u043d\\u0438\\u044f \\u0444\\u0430\\u0439\\u043b\\u043e\\u0432. \\u0412\\u044b \\u043f\\u043e\\u043b\\u0443\\u0447\\u0430\\u0435\\u0442\\u0435 \\u0441\\u0432\\u043e\\u0431\\u043e\\u0434\\u0443 \\u0441\\u043e\\u0445\\u0440\\u0430\\u043d\\u044f\\u0442\\u044c, \\u0442\\u0432\\u043e\\u0440\\u0438\\u0442\\u044c \\u0438 \\u043d\\u0430\\u043a\\u0430\\u043f\\u043b\\u0438\\u0432\\u0430\\u0442\\u044c \\u0431\\u0435\\u0437 \\u043e\\u0433\\u043b\\u044f\\u0434\\u043a\\u0438 \\u043d\\u0430 \\u043d\\u0435\\u0434\\u043e\\u0441\\u0442\\u0430\\u0442\\u043e\\u043a \\u043c\\u0435\\u0441\\u0442\\u0430.<br \\/>\\n<br \\/>\\n\\u041d\\u043e \\u0451\\u043c\\u043a\\u043e\\u0441\\u0442\\u044c \\u2014 \\u044d\\u0442\\u043e \\u043b\\u0438\\u0448\\u044c \\u043e\\u0434\\u043d\\u0430 \\u0441\\u0442\\u043e\\u0440\\u043e\\u043d\\u0430 \\u043c\\u0435\\u0434\\u0430\\u043b\\u0438. \\u0421\\u043a\\u043e\\u0440\\u043e\\u0441\\u0442\\u044c \\u044f\\u0432\\u043b\\u044f\\u0435\\u0442\\u0441\\u044f \\u043a\\u043b\\u044e\\u0447\\u0435\\u0432\\u044b\\u043c \\u043f\\u0440\\u0435\\u0438\\u043c\\u0443\\u0449\\u0435\\u0441\\u0442\\u0432\\u043e\\u043c \\u043c\\u043e\\u0434\\u0435\\u043b\\u0438 WD Black. \\u0411\\u043b\\u0430\\u0433\\u043e\\u0434\\u0430\\u0440\\u044f \\u0441\\u043a\\u043e\\u0440\\u043e\\u0441\\u0442\\u0438 \\u0432\\u0440\\u0430\\u0449\\u0435\\u043d\\u0438\\u044f \\u0448\\u043f\\u0438\\u043d\\u0434\\u0435\\u043b\\u044f 7200 \\u043e\\u0431\\u043e\\u0440\\u043e\\u0442\\u043e\\u0432 \\u0432 \\u043c\\u0438\\u043d\\u0443\\u0442\\u0443 \\u0438 \\u0438\\u043d\\u0442\\u0435\\u0440\\u0444\\u0435\\u0439\\u0441\\u0443 SATA-III, \\u0432\\u044b \\u043f\\u043e\\u043b\\u0443\\u0447\\u0430\\u0435\\u0442\\u0435 \\u043c\\u0430\\u043a\\u0441\\u0438\\u043c\\u0430\\u043b\\u044c\\u043d\\u043e \\u0432\\u043e\\u0437\\u043c\\u043e\\u0436\\u043d\\u0443\\u044e \\u043f\\u0440\\u043e\\u043f\\u0443\\u0441\\u043a\\u043d\\u0443\\u044e \\u0441\\u043f\\u043e\\u0441\\u043e\