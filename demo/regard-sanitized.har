043e\\u0442\\u044b. \\u0416\\u0451\\u0441\\u0442\\u043a\\u0438\\u0439 \\u0434\\u0438\\u0441\\u043a Toshiba MG11 (MG11ACA20TE) \\u043f\\u0440\\u0435\\u0434\\u0441\\u0442\\u0430\\u0432\\u043b\\u044f\\u0435\\u0442 \\u0441\\u043e\\u0431\\u043e\\u0439 \\u0438\\u043d\\u0436\\u0435\\u043d\\u0435\\u0440\\u043d\\u043e\\u0435 \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435, \\u0441\\u043e\\u0437\\u0434\\u0430\\u043d\\u043d\\u043e\\u0435 \\u0434\\u043b\\u044f \\u0441\\u0430\\u043c\\u044b\\u0445 \\u043e\\u0442\\u0432\\u0435\\u0442\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u044b\\u0445 \\u0437\\u0430\\u0434\\u0430\\u0447. \\u042d\\u0442\\u043e \\u0432\\u043d\\u0443\\u0442\\u0440\\u0435\\u043d\\u043d\\u0438\\u0439 \\u043d\\u0430\\u043a\\u043e\\u043f\\u0438\\u0442\\u0435\\u043b\\u044c \\u0444\\u043e\\u0440\\u043c-\\u0444\\u0430\\u043a\\u0442\\u043e\\u0440\\u0430 3,5 \\u0434\\u044e\\u0439\\u043c\\u0430, \\u043f\\u0440\\u0435\\u0434\\u043d\\u0430\\u0437\\u043d\\u0430\\u0447\\u0435\\u043d\\u043d\\u044b\\u0439 \\u0438\\u0441\\u043a\\u043b\\u044e\\u0447\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e \\u0434\\u043b\\u044f \\u0446\\u0435\\u043d\\u0442\\u0440\\u043e\\u0432 \\u043e\\u0431\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0438 \\u0434\\u0430\\u043d\\u043d\\u044b\\u0445, \\u0433\\u0434\\u0435 \\u043a\\u0430\\u0436\\u0434\\u0430\\u044f \\u043c\\u0438\\u043d\\u0443\\u0442\\u0430 \\u043f\\u0440\\u043e\\u0441\\u0442\\u043e\\u044f \\u043e\\u0431\\u043e\\u0440\\u0430\\u0447\\u0438\\u0432\\u0430\\u0435\\u0442\\u0441\\u044f \\u0441\\u0435\\u0440\\u044c\\u0451\\u0437\\u043d\\u044b\\u043c\\u0438 \\u043f\\u043e\\u0442\\u0435\\u0440\\u044f\\u043c\\u0438.<br \\/>\\n<br \\/>\\n\\u0421\\u0435\\u0440\\u0434\\u0446\\u0435\\u043c \\u0443\\u0441\\u0442\\u0440\\u043e\\u0439\\u0441\\u0442\\u0432\\u0430 \\u044f\\u0432\\u043b\\u044f\\u0435\\u0442\\u0441\\u044f \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u0435\\u043d\\u043d\\u0430\\u044f \\u0442\\u0435\\u0445\\u043d\\u043e\\u043b\\u043e\\u0433\\u0438\\u044f \\u043c\\u0430\\u0433\\u043d\\u0438\\u0442\\u043d\\u043e\\u0439 \\u0437\\u0430\\u043f\\u0438\\u0441\\u0438 CMR. \\u0412 \\u043e\\u0442\\u043b\\u0438\\u0447\\u0438\\u0435 \\u043e\\u0442 \\u043a\\u043e\\u043c\\u043f\\u0440\\u043e\\u043c\\u0438\\u0441\\u0441\\u043d\\u044b\\u0445 \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0439, \\u043a\\u043b\\u0430\\u0441\\u0441\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438\\u0439 \\u043c\\u0435\\u0442\\u043e\\u0434 \\u0437\\u0430\\u043f\\u0438\\u0441\\u0438 \\u0433\\u0430\\u0440\\u0430\\u043d\\u0442\\u0438\\u0440\\u0443\\u0435\\u0442 \\u0441\\u0442\\u0430\\u0431\\u0438\\u043b\\u044c\\u043d\\u0443\\u044e \\u0441\\u043a\\u043e\\u0440\\u043e\\u0441\\u0442\\u044c \\u0447\\u0442\\u0435\\u043d\\u0438\\u044f \\u0438 \\u0437\\u0430\\u043f\\u0438\\u0441\\u0438 \\u043f\\u0440\\u0438 \\u043b\\u044e\\u0431\\u044b\\u0445 \\u0441\\u0446\\u0435\\u043d\\u0430\\u0440\\u0438\\u044f\\u0445 \\u043d\\u0430\\u0433\\u0440\\u0443\\u0437\\u043a\\u0438, \\u0447\\u0442\\u043e \\u043a\\u0440\\u0438\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438 \\u0432\\u0430\\u0436\\u043d\\u043e \\u0434\\u043b\\u044f \\u0431\\u0430\\u0437 \\u0434\\u0430\\u043d\\u043d\\u044b\\u0445 \\u0438 \\u0441\\u0438\\u0441\\u0442\\u0435\\u043c \\u0432\\u0438\\u0434\\u0435\\u043e\\u043d\\u0430\\u0431\\u043b\\u044e\\u0434\\u0435\\u043d\\u0438\\u044f. \\u041e\\u0431\\u044a\\u0451\\u043c \\u0436\\u0451\\u0441\\u0442\\u043a\\u043e\\u0433\\u043e \\u0434\\u0438\\u0441\\u043a\\u0430 \\u0441\\u043e\\u0441\\u0442\\u0430\\u0432\\u043b\\u044f\\u0435\\u0442 20000 \\u0433\\u0438\\u0433\\u0430\\u0431\\u0430\\u0439\\u0442 \\u2014 \\u044d\\u0442\\u043e \\u0434\\u0432\\u0430\\u0434\\u0446\\u0430\\u0442\\u044c \\u0442\\u0435\\u0440\\u0430\\u0431\\u0430\\u0439\\u0442 \\u043f\\u043e\\u043b\\u0435\\u0437\\u043d\\u043e\\u0433\\u043e \\u043f\\u0440\\u043e\\u0441\\u0442\\u0440\\u0430\\u043d\\u0441\\u0442\\u0432\\u0430, \\u043f\\u043e\\u0437\\u0432\\u043e\\u043b\\u044f\\u044e\\u0449\\u0438\\u0435 \\u0445\\u0440\\u0430\\u043d\\u0438\\u0442\\u044c \\u043e\\u0433\\u0440\\u043e\\u043c\\u043d\\u044b\\u0435 \\u043c\\u0430\\u0441\\u0441\\u0438\\u0432\\u044b \\u0438\\u043d\\u0444\\u043e\\u0440\\u043c\\u0430\\u0446\\u0438\\u0438 \\u0431\\u0435\\u0437 \\u043d\\u0435\\u043e\\u0431\\u0445\\u043e\\u0434\\u0438\\u043c\\u043e\\u0441\\u0442\\u0438 \\u0447\\u0430\\u0441\\u0442\\u043e\\u0439 \\u0437\\u0430\\u043c\\u0435\\u043d\\u044b \\u043d\\u043e\\u0441\\u0438\\u0442\\u0435\\u043b\\u0435\\u0439. \\u0411\\u043b\\u0430\\u0433\\u043e\\u0434\\u0430\\u0440\\u044f \\u0451\\u043c\\u043a\\u043e\\u0441\\u0442\\u0438 \\u0431\\u0443\\u0444\\u0435\\u0440\\u043d\\u043e\\u0439 \\u043f\\u0430\\u043c\\u044f\\u0442\\u0438 \\u0432 1024 \\u043c\\u0435\\u0433\\u0430\\u0431\\u0430\\u0439\\u0442\\u0430, \\u043a\\u043e\\u043d\\u0442\\u0440\\u043e\\u043b\\u043b\\u0435\\u0440 \\u044d\\u0444\\u0444\\u0435\\u043a\\u0442\\u0438\\u0432\\u043d\\u043e \\u0443\\u043f\\u0440\\u0430\\u0432\\u043b\\u044f\\u0435\\u0442 \\u043f\\u043e\\u0442\\u043e\\u043a\\u0430\\u043c\\u0438 \\u0434\\u0430\\u043d\\u043d\\u044b\\u0445, \\u0441\\u0433\\u043b\\u0430\\u0436\\u0438\\u0432\\u0430\\u044f \\u043f\\u0438\\u043a\\u043e\\u0432\\u044b\\u0435 \\u043d\\u0430\\u0433\\u0440\\u0443\\u0437\\u043a\\u0438 \\u0438 \\u0443\\u0441\\u043a\\u043e\\u0440\\u044f\\u044f \\u043e\\u0431\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0438 \\u043f\\u043e\\u0432\\u0442\\u043e\\u0440\\u044f\\u044e\\u0449\\u0438\\u0445\\u0441\\u044f \\u0437\\u0430\\u043f\\u0440\\u043e\\u0441\\u043e\\u0432.<br \\/>\\n<br \\/>\\n\\u0421\\u043a\\u043e\\u0440\\u043e\\u0441\\u0442\\u044c \\u0432\\u0440\\u0430\\u0449\\u0435\\u043d\\u0438\\u044f \\u0448\\u043f\\u0438\\u043d\\u0434\\u0435\\u043b\\u044f 7200 \\u043e\\u0431\\u043e\\u0440\\u043e\\u0442\\u043e\\u0432 \\u0432 \\u043c\\u0438\\u043d\\u0443\\u0442\\u0443 \\u043e\\u0431\\u0435\\u0441\\u043f\\u0435\\u0447\\u0438\\u0432\\u0430\\u0435\\u0442 \\u0432\\u044b\\u0441\\u043e\\u043a\\u0443\\u044e \\u043f\\u0440\\u043e\\u0438\\u0437\\u0432\\u043e\\u0434\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u044c, \\u0445\\u0430\\u0440\\u0430\\u043a\\u0442\\u0435\\u0440\\u043d\\u0443\\u044e \\u0434\\u043b\\u044f \\u043a\\u043e\\u0440\\u043f\\u043e\\u0440\\u0430\\u0442\\u0438\\u0432\\u043d\\u043e\\u0433\\u043e \\u0441\\u0435\\u0433\\u043c\\u0435\\u043d\\u0442\\u0430. \\u0412 \\u0441\\u043e\\u0447\\u0435\\u0442\\u0430\\u043d\\u0438\\u0438 \\u0441 \\u0438\\u043d\\u0442\\u0435\\u0440\\u0444\\u0435\\u0439\\u0441\\u043e\\u043c SATA-III, \\u043f\\u0440\\u043e\\u043f\\u0443\\u0441\\u043a\\u043d\\u0430\\u044f \\u0441\\u043f\\u043e\\u0441\\u043e\\u0431\\u043d\\u043e\\u0441\\u0442\\u044c \\u043a\\u043e\\u0442\\u043e\\u0440\\u043e\\u0433\\u043e \\u0434\\u043e\\u0441\\u0442\\u0438\\u0433\\u0430\\u0435\\u0442 6 \\u0433\\u0438\\u0433\\u0430\\u0431\\u0438\\u0442 \\u0432 \\u0441\\u0435\\u043a\\u0443\\u043d\\u0434\\u0443, \\u043d\\u0430\\u043a\\u043e\\u043f\\u0438\\u0442\\u0435\\u043b\\u044c \\u0434\\u0435\\u043c\\u043e\\u043d\\u0441\\u0442\\u0440\\u0438\\u0440\\u0443\\u0435\\u0442 \\u043e\\u0442\\u043b\\u0438\\u0447\\u043d\\u044b\\u0435 \\u043f\\u043e\\u043a\\u0430\\u0437\\u0430\\u0442\\u0435\\u043b\\u0438 \\u043f\\u0440\\u0438 \\u043f\\u043e\\u0441\\u043b\\u0435\\u0434\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u043c \\u0447\\u0442\\u0435\\u043d\\u0438\\u0438 \\u0438 \\u0437\\u0430\\u043f\\u0438\\u0441\\u0438. \\u042d\\u0442\\u043e \\u043f\\u043e\\u0437\\u0432\\u043e\\u043b\\u044f\\u0435\\u0442 \\u0438\\u0441\\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u044c \\u0435\\u0433\\u043e \\u043d\\u0435 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0434\\u043b\\u044f \\u0445\\u043e\\u043b\\u043e\\u0434\\u043d\\u043e\\u0433\\u043e \\u0445\\u0440\\u0430\\u043d\\u0435\\u043d\\u0438\\u044f \\u0430\\u0440\\u0445\\u0438\\u0432\\u043e\\u0432, \\u043d\\u043e \\u0438 \\u0434\\u043b\\u044f \\u0430\\u043a\\u0442\\u0438\\u0432\\u043d\\u043e\\u0439 \\u0440\\u0430\\u0431\\u043e\\u0442\\u044b \\u0441 \\u0447\\u0430\\u0441\\u0442\\u043e \\u0437\\u0430\\u043f\\u0440\\u0430\\u0448\\u0438\\u0432\\u0430\\u0435\\u043c\\u044b\\u043c\\u0438 \\u0434\\u0430\\u043d\\u043d\\u044b\\u043c\\u0438. \\u041a\\u0430\\u0436\\u0434\\u044b\\u0439 \\u043a\\u043e\\u043c\\u043f\\u043e\\u043d\\u0435\\u043d\\u0442 \\u0434\\u0438\\u0441\\u043a\\u0430 \\u0441\\u043f\\u0440\\u043e\\u0435\\u043a\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d \\u0441 \\u0443\\u0447\\u0451\\u0442\\u043e\\u043c \\u043a\\u0440\\u0443\\u0433\\u043b\\u043e\\u0441\\u0443\\u0442\\u043e\\u0447\\u043d\\u043e\\u0439 \\u044d\\u043a\\u0441\\u043f\\u043b\\u0443\\u0430\\u0442\\u0430\\u0446\\u0438\\u0438, \\u0447\\u0442\\u043e \\u043f\\u043e\\u0434\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0430\\u0435\\u0442\\u0441\\u044f \\u0437\\u0430\\u044f\\u0432\\u043b\\u0435\\u043d\\u043d\\u044b\\u043c \\u0432\\u0440\\u0435\\u043c\\u0435\\u043d\\u0435\\u043c \\u043d\\u0430\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0438 \\u043d\\u0430 \\u043e\\u0442\\u043a\\u0430\\u0437 \\u2014 2 500 000 \\u0447\\u0430\\u0441\\u043e\\u0432. \\u0414\\u0430\\u043d\\u043d\\u044b\\u0439 \\u043f\\u043e\\u043a\\u0430\\u0437\\u0430\\u0442\\u0435\\u043b\\u044c \\u0433\\u043e\\u0432\\u043e\\u0440\\u0438\\u0442 \\u043e \\u0442\\u043e\\u043c, \\u0447\\u0442\\u043e \\u0443\\u0441\\u0442\\u0440\\u043e\\u0439\\u0441\\u0442\\u0432\\u043e \\u0440\\u0430\\u0441\\u0441\\u0447\\u0438\\u0442\\u0430\\u043d\\u043e \\u043d\\u0430 \\u0433\\u043e\\u0434\\u044b \\u043d\\u0435\\u043f\\u0440\\u0435\\u0440\\u044b\\u0432\\u043d\\u043e\\u0439 \\u0441\\u043b\\u0443\\u0436\\u0431\\u044b \\u0432 \\u0441\\u0430\\u043c\\u044b\\u0445 \\u0436\\u0451\\u0441\\u0442\\u043a\\u0438\\u0445 \\u0443\\u0441\\u043b\\u043e\\u0432\\u0438\\u044f\\u0445.<br \\/>\\n<br \\/>\\n\\u041f\\u0440\\u0438 \\u0440\\u0430\\u0437\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0435 \\u043c\\u043e\\u0434\\u0435\\u043b\\u0438 MG11ACA20TE \\u0438\\u043d\\u0436\\u0435\\u043d\\u0435\\u0440\\u044b Toshiba \\u0443\\u0434\\u0435\\u043b\\u0438\\u043b\\u0438 \\u043e\\u0441\\u043e\\u0431\\u043e\\u0435 \\u0432\\u043d\\u0438\\u043c\\u0430\\u043d\\u0438\\u0435 \\u0432\\u043e\\u043f\\u0440\\u043e\\u0441\\u0430\\u043c \\u0432\\u0438\\u0431\\u0440\\u0430\\u0446\\u0438\\u043e\\u043d\\u043d\\u043e\\u0439 \\u0443\\u0441\\u0442\\u043e\\u0439\\u0447\\u0438\\u0432\\u043e\\u0441\\u0442\\u0438. \\u0412 \\u043c\\u043d\\u043e\\u0433\\u043e\\u0434\\u0438\\u0441\\u043a\\u043e\\u0432\\u044b\\u0445 \\u043c\\u0430\\u0441\\u0441\\u0438\\u0432\\u0430\\u0445, \\u0433\\u0434\\u0435 \\u0440\\u044f\\u0434\\u043e\\u043c \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u044e\\u0442 \\u0434\\u0435\\u0441\\u044f\\u0442\\u043a\\u0438 \\u043d\\u0430\\u043a\\u043e\\u043f\\u0438\\u0442\\u0435\\u043b\\u0435\\u0439, \\u0432\\u0437\\u0430\\u0438\\u043c\\u043d\\u043e\\u0435 \\u0432\\u043b\\u0438\\u044f\\u043d\\u0438\\u0435 \\u043c\\u043e\\u0436\\u0435\\u0442 \\u043f\\u0440\\u0438\\u0432\\u043e\\u0434\\u0438\\u0442\\u044c \\u043a \\u043e\\u0448\\u0438\\u0431\\u043a\\u0430\\u043c \\u043f\\u043e\\u0437\\u0438\\u0446\\u0438\\u043e\\u043d\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044f \\u0433\\u043e\\u043b\\u043e\\u0432\\u043e\\u043a. \\u0414\\u0430\\u043d\\u043d\\u0430\\u044f \\u043c\\u043e\\u0434\\u0435\\u043b\\u044c \\u043e\\u0441\\u043d\\u0430\\u0449\\u0435\\u043d\\u0430 \\u0443\\u0441\\u043e\\u0432\\u0435\\u0440\\u0448\\u0435\\u043d\\u0441\\u0442\\u0432\\u043e\\u0432\\u0430\\u043d\\u043d\\u044b\\u043c\\u0438 \\u043c\\u0435\\u0445\\u0430\\u043d\\u0438\\u0437\\u043c\\u0430\\u043c\\u0438 \\u043a\\u043e\\u043c\\u043f\\u0435\\u043d\\u0441\\u0430\\u0446\\u0438\\u0438 \\u0432\\u0438\\u0431\\u0440\\u0430\\u0446\\u0438\\u0439, \\u0447\\u0442\\u043e \\u0433\\u0430\\u0440\\u0430\\u043d\\u0442\\u0438\\u0440\\u0443\\u0435\\u0442 \\u0446\\u0435\\u043b\\u043e\\u0441\\u0442\\u043d\\u043e\\u0441\\u0442\\u044c \\u0434\\u0430\\u043d\\u043d\\u044b\\u0445 \\u0434\\u0430\\u0436\\u0435 \\u0432 \\u043f\\u043b\\u043e\\u0442\\u043d\\u044b\\u0445 \\u0441\\u0435\\u0440\\u0432\\u0435\\u0440\\u043d\\u044b\\u0445 \\u0441\\u0442\\u043e\\u0439\\u043a\\u0430\\u0445. \\u041a\\u0440\\u043e\\u043c\\u0435 \\u0442\\u043e\\u0433\\u043e, \\u0438\\u0441\\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435 \\u0442\\u0435\\u0445\\u043d\\u043e\\u043b\\u043e\\u0433\\u0438\\u0438 CMR \\u0438\\u0441\\u043a\\u043b\\u044e\\u0447\\u0430\\u0435\\u0442 \\u0445\\u0430\\u0440\\u0430\\u043a\\u0442\\u0435\\u0440\\u043d\\u043e\\u0435 \\u0434\\u043b\\u044f \\u0447\\u0435\\u0440\\u0435\\u043f\\u0438\\u0447\\u043d\\u043e\\u0439 \\u0437\\u0430\\u043f\\u0438\\u0441\\u0438 \\u043f\\u0430\\u0434\\u0435\\u043d\\u0438\\u0435 \\u0441\\u043a\\u043e\\u0440\\u043e\\u0441\\u0442\\u0438 \\u043f\\u0440\\u0438 \\u043f\\u0435\\u0440\\u0435\\u0437\\u0430\\u043f\\u0438\\u0441\\u0438, \\u0447\\u0442\\u043e \\u0434\\u0435\\u043b\\u0430\\u0435\\u0442 \\u0434\\u0438\\u0441\\u043a \\u043f\\u0440\\u0435\\u0434\\u0441\\u043a\\u0430\\u0437\\u0443\\u0435\\u043c\\u044b\\u043c \\u0432 \\u0440\\u0430\\u0431\\u043e\\u0442\\u0435.<br \\/>\\n<br \\/>\\n\\u0412\\u044b\\u0431\\u0438\\u0440\\u0430\\u044f Toshiba MG11, \\u0432\\u044b \\u043f\\u043e\\u043b\\u0443\\u0447\\u0430\\u0435\\u0442\\u0435 \\u043d\\u0435 \\u043f\\u0440\\u043e\\u0441\\u0442\\u043e \\u043d\\u043e\\u0441\\u0438\\u0442\\u0435\\u043b\\u044c \\u0438\\u043d\\u0444\\u043e\\u0440\\u043c\\u0430\\u0446\\u0438\\u0438, \\u0430 \\u043f\\u0440\\u043e\\u0444\\u0435\\u0441\\u0441\\u0438\\u043e\\u043d\\u0430\\u043b\\u044c\\u043d\\u044b\\u0439 \\u0438\\u043d\\u0441\\u0442\\u0440\\u0443\\u043c\\u0435\\u043d\\u0442 \\u0434\\u043b\\u044f \\u043f\\u043e\\u0441\\u0442\\u0440\\u043e\\u0435\\u043d\\u0438\\u044f \\u043e\\u0442\\u043a\\u0430\\u0437\\u043e\\u0443\\u0441\\u0442\\u043e\\u0439\\u0447\\u0438\\u0432\\u043e\\u0439 \\u0438\\u043d\\u0444\\u0440\\u0430\\u0441\\u0442\\u0440\\u0443\\u043a\\u0442\\u0443\\u0440\\u044b. \\u042d\\u0442\\u043e\\u0442 \\u0436\\u0451\\u0441\\u0442\\u043a\\u