b\\u0432\\u043d\\u043e\\u0439 \\u0437\\u0430\\u043f\\u0438\\u0441\\u0438 \\u0434\\u0430\\u043d\\u043d\\u044b\\u0445.  <br \\/>\\n<br \\/>\\n\\u0414\\u0438\\u0441\\u043a \\u0432\\u044b\\u043f\\u043e\\u043b\\u043d\\u0435\\u043d \\u0432 \\u0444\\u043e\\u0440\\u043c-\\u0444\\u0430\\u043a\\u0442\\u043e\\u0440\\u0435 3,5\\\" \\u0438 \\u043f\\u043e\\u0434\\u043a\\u043b\\u044e\\u0447\\u0430\\u0435\\u0442\\u0441\\u044f \\u0447\\u0435\\u0440\\u0435\\u0437 \\u0438\\u043d\\u0442\\u0435\\u0440\\u0444\\u0435\\u0439\\u0441 SATA-III, \\u043e\\u0431\\u0435\\u0441\\u043f\\u0435\\u0447\\u0438\\u0432\\u0430\\u044f \\u0431\\u044b\\u0441\\u0442\\u0440\\u0443\\u044e \\u043f\\u0435\\u0440\\u0435\\u0434\\u0430\\u0447\\u0443 \\u0434\\u0430\\u043d\\u043d\\u044b\\u0445. \\u041e\\u0431\\u044a\\u0451\\u043c \\u0432 1000 \\u0413\\u0411 \\u043f\\u043e\\u0437\\u0432\\u043e\\u043b\\u044f\\u0435\\u0442 \\u0445\\u0440\\u0430\\u043d\\u0438\\u0442\\u044c \\u0437\\u043d\\u0430\\u0447\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u044b\\u0435 \\u043e\\u0431\\u044a\\u0451\\u043c\\u044b \\u0432\\u0438\\u0434\\u0435\\u043e\\u0437\\u0430\\u043f\\u0438\\u0441\\u0435\\u0439 \\u0431\\u0435\\u0437 \\u043d\\u0435\\u043e\\u0431\\u0445\\u043e\\u0434\\u0438\\u043c\\u043e\\u0441\\u0442\\u0438 \\u0447\\u0430\\u0441\\u0442\\u043e\\u0433\\u043e \\u0443\\u0434\\u0430\\u043b\\u0435\\u043d\\u0438\\u044f \\u0438\\u043b\\u0438 \\u043f\\u0435\\u0440\\u0435\\u043d\\u043e\\u0441\\u0430 \\u0444\\u0430\\u0439\\u043b\\u043e\\u0432. \\u042d\\u0442\\u043e \\u043e\\u0441\\u043e\\u0431\\u0435\\u043d\\u043d\\u043e \\u0432\\u0430\\u0436\\u043d\\u043e \\u0434\\u043b\\u044f \\u0441\\u0438\\u0441\\u0442\\u0435\\u043c \\u0432\\u0438\\u0434\\u0435\\u043e\\u043d\\u0430\\u0431\\u043b\\u044e\\u0434\\u0435\\u043d\\u0438\\u044f, \\u0433\\u0434\\u0435 \\u043a\\u0440\\u0438\\u0442\\u0438\\u0447\\u043d\\u0430 \\u043d\\u0435 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0451\\u043c\\u043a\\u043e\\u0441\\u0442\\u044c, \\u043d\\u043e \\u0438 \\u043d\\u0430\\u0434\\u0451\\u0436\\u043d\\u043e\\u0441\\u0442\\u044c \\u0445\\u0440\\u0430\\u043d\\u0435\\u043d\\u0438\\u044f \\u0438\\u043d\\u0444\\u043e\\u0440\\u043c\\u0430\\u0446\\u0438\\u0438.  <br \\/>\\n<br \\/>\\n\\u0421\\u043a\\u043e\\u0440\\u043e\\u0441\\u0442\\u044c \\u0432\\u0440\\u0430\\u0449\\u0435\\u043d\\u0438\\u044f \\u0448\\u043f\\u0438\\u043d\\u0434\\u0435\\u043b\\u044f 5700 \\u043e\\u0431\\/\\u043c\\u0438\\u043d \\u043e\\u0431\\u0435\\u0441\\u043f\\u0435\\u0447\\u0438\\u0432\\u0430\\u0435\\u0442 \\u043e\\u043f\\u0442\\u0438\\u043c\\u0430\\u043b\\u044c\\u043d\\u044b\\u0439 \\u0431\\u0430\\u043b\\u0430\\u043d\\u0441 \\u043c\\u0435\\u0436\\u0434\\u0443 \\u043f\\u0440\\u043e\\u0438\\u0437\\u0432\\u043e\\u0434\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u044c\\u044e \\u0438 \\u044d\\u043d\\u0435\\u0440\\u0433\\u043e\\u043f\\u043e\\u0442\\u0440\\u0435\\u0431\\u043b\\u0435\\u043d\\u0438\\u0435\\u043c. \\u0422\\u0430\\u043a\\u043e\\u0439 \\u0440\\u0435\\u0436\\u0438\\u043c \\u0440\\u0430\\u0431\\u043e\\u0442\\u044b \\u0441\\u043d\\u0438\\u0436\\u0430\\u0435\\u0442 \\u043d\\u0430\\u0433\\u0440\\u0435\\u0432 \\u0438 \\u043f\\u0440\\u043e\\u0434\\u043b\\u0435\\u0432\\u0430\\u0435\\u0442 \\u0441\\u0440\\u043e\\u043a \\u0441\\u043b\\u0443\\u0436\\u0431\\u044b \\u0434\\u0438\\u0441\\u043a\\u0430, \\u0447\\u0442\\u043e \\u043e\\u0441\\u043e\\u0431\\u0435\\u043d\\u043d\\u043e \\u0432\\u0430\\u0436\\u043d\\u043e \\u0434\\u043b\\u044f \\u0443\\u0441\\u0442\\u0440\\u043e\\u0439\\u0441\\u0442\\u0432, \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u044e\\u0449\\u0438\\u0445 \\u0432 \\u0440\\u0435\\u0436\\u0438\\u043c\\u0435 24\\/7. \\u0411\\u0443\\u0444\\u0435\\u0440\\u043d\\u0430\\u044f \\u043f\\u0430\\u043c\\u0441\\u0442\\u044c \\u043e\\u0431\\u044a\\u0451\\u043c\\u043e\\u043c 64 \\u041c\\u0411 \\u0443\\u0441\\u043a\\u043e\\u0440\\u044f\\u0435\\u0442 \\u043e\\u0431\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0443 \\u0434\\u0430\\u043d\\u043d\\u044b\\u0445, \\u043c\\u0438\\u043d\\u0438\\u043c\\u0438\\u0437\\u0438\\u0440\\u0443\\u044f \\u0437\\u0430\\u0434\\u0435\\u0440\\u0436\\u043a\\u0438 \\u043f\\u0440\\u0438 \\u0437\\u0430\\u043f\\u0438\\u0441\\u0438 \\u0438 \\u0447\\u0442\\u0435\\u043d\\u0438\\u0438 \\u0438\\u043d\\u0444\\u043e\\u0440\\u043c\\u0430\\u0446\\u0438\\u0438.  <br \\/>\\n<br \\/>\\n\\u0416\\u0451\\u0441\\u0442\\u043a\\u0438\\u0439 \\u0434\\u0438\\u0441\\u043a Toshiba S300 Surveillance \\u0440\\u0430\\u0437\\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u043d \\u0441 \\u0443\\u0447\\u0451\\u0442\\u043e\\u043c \\u0441\\u043f\\u0435\\u0446\\u0438\\u0444\\u0438\\u043a\\u0438 \\u0440\\u0430\\u0431\\u043e\\u0442\\u044b \\u0432 \\u0441\\u0438\\u0441\\u0442\\u0435\\u043c\\u0430\\u0445 \\u0432\\u0438\\u0434\\u0435\\u043e\\u043d\\u0430\\u0431\\u043b\\u044e\\u0434\\u0435\\u043d\\u0438\\u044f. \\u041e\\u043d \\u043f\\u043e\\u0434\\u0434\\u0435\\u0440\\u0436\\u0438\\u0432\\u0430\\u0435\\u0442 \\u0442\\u0435\\u0445\\u043d\\u043e\\u043b\\u043e\\u0433\\u0438\\u044e AllFrame, \\u043a\\u043e\\u0442\\u043e\\u0440\\u0430\\u044f \\u0443\\u043b\\u0443\\u0447\\u0448\\u0430\\u0435\\u0442 \\u043a\\u0430\\u0447\\u0435\\u0441\\u0442\\u0432\\u043e \\u0437\\u0430\\u043f\\u0438\\u0441\\u0438 \\u0437\\u0430 \\u0441\\u0447\\u0451\\u0442 \\u0443\\u043c\\u0435\\u043d\\u044c\\u0448\\u0435\\u043d\\u0438\\u044f \\u043a\\u043e\\u043b\\u0438\\u0447\\u0435\\u0441\\u0442\\u0432\\u0430 \\u043f\\u0440\\u043e\\u043f\\u0443\\u0449\\u0435\\u043d\\u043d\\u044b\\u0445 \\u043a\\u0430\\u0434\\u0440\\u043e\\u0432 \\u0438 \\u043e\\u0448\\u0438\\u0431\\u043e\\u043a. \\u042d\\u0442\\u043e \\u043e\\u0441\\u043e\\u0431\\u0435\\u043d\\u043d\\u043e \\u0432\\u0430\\u0436\\u043d\\u043e \\u043f\\u0440\\u0438 \\u0440\\u0430\\u0431\\u043e\\u0442\\u0435 \\u0441 \\u043d\\u0435\\u0441\\u043a\\u043e\\u043b\\u044c\\u043a\\u0438\\u043c\\u0438 \\u043a\\u0430\\u043c\\u0435\\u0440\\u0430\\u043c\\u0438 \\u0432\\u044b\\u0441\\u043e\\u043a\\u043e\\u0433\\u043e \\u0440\\u0430\\u0437\\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u044f, \\u043a\\u043e\\u0433\\u0434\\u0430 \\u0442\\u0440\\u0435\\u0431\\u0443\\u0435\\u0442\\u0441\\u044f \\u043e\\u0434\\u043d\\u043e\\u0432\\u0440\\u0435\\u043c\\u0435\\u043d\\u043d\\u0430\\u044f \\u0437\\u0430\\u043f\\u0438\\u0441\\u044c \\u043c\\u043d\\u043e\\u0436\\u0435\\u0441\\u0442\\u0432\\u0430 \\u043f\\u043e\\u0442\\u043e\\u043a\\u043e\\u0432 \\u0434\\u0430\\u043d\\u043d\\u044b\\u0445.  <br \\/>\\n<br \\/>\\n\\u0412\\u044b\\u0441\\u043e\\u043a\\u0430\\u044f \\u043d\\u0430\\u0434\\u0451\\u0436\\u043d\\u043e\\u0441\\u0442\\u044c \\u043f\\u043e\\u0434\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0430\\u0435\\u0442\\u0441\\u044f \\u0432\\u0440\\u0435\\u043c\\u0435\\u043d\\u0435\\u043c \\u043d\\u0430\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0438 \\u043d\\u0430 \\u043e\\u0442\\u043a\\u0430\\u0437 \\u2013 1 000 000 \\u0447\\u0430\\u0441\\u043e\\u0432. \\u042d\\u0442\\u043e \\u043e\\u0437\\u043d\\u0430\\u0447\\u0430\\u0435\\u0442, \\u0447\\u0442\\u043e \\u0434\\u0438\\u0441\\u043a \\u0440\\u0430\\u0441\\u0441\\u0447\\u0438\\u0442\\u0430\\u043d \\u043d\\u0430 \\u0434\\u043b\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u0443\\u044e \\u044d\\u043a\\u0441\\u043f\\u043b\\u0443\\u0430\\u0442\\u0430\\u0446\\u0438\\u044e \\u0432 \\u0443\\u0441\\u043b\\u043e\\u0432\\u0438\\u044f\\u0445 \\u043f\\u043e\\u0441\\u0442\\u043e\\u044f\\u043d\\u043d\\u043e\\u0439 \\u043d\\u0430\\u0433\\u0440\\u0443\\u0437\\u043a\\u0438. \\u0423\\u0441\\u0442\\u043e\\u0439\\u0447\\u0438\\u0432\\u043e\\u0441\\u0442\\u044c \\u043a \\u0432\\u0438\\u0431\\u0440\\u0430\\u0446\\u0438\\u0438 \\u0438 \\u043f\\u0435\\u0440\\u0435\\u043f\\u0430\\u0434\\u0430\\u043c \\u0442\\u0435\\u043c\\u043f\\u0435\\u0440\\u0430\\u0442\\u0443\\u0440 \\u043f\\u043e\\u0437\\u0432\\u043e\\u043b\\u044f\\u0435\\u0442 \\u0438\\u0441\\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u044c \\u0435\\u0433\\u043e \\u0432 \\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u043d\\u044b\\u0445 \\u0443\\u0441\\u043b\\u043e\\u0432\\u0438\\u044f\\u0445, \\u0432\\u043a\\u043b\\u044e\\u0447\\u0430\\u044f \\u0441\\u0435\\u0440\\u0432\\u0435\\u0440\\u043d\\u044b\\u0435 \\u043a\\u043e\\u043c\\u043d\\u0430\\u0442\\u044b \\u0438 \\u043d\\u0430\\u0440\\u0443\\u0436\\u043d\\u044b\\u0435 \\u0441\\u0438\\u0441\\u0442\\u0435\\u043c\\u044b \\u0432\\u0438\\u0434\\u0435\\u043e\\u043d\\u0430\\u0431\\u043b\\u044e\\u0434\\u0435\\u043d\\u0438\\u044f.  <br \\/>\\n<br \\/>\\n\\u042d\\u043d\\u0435\\u0440\\u0433\\u043e\\u044d\\u0444\\u0444\\u0435\\u043a\\u0442\\u0438\\u0432\\u043d\\u043e\\u0441\\u0442\\u044c \\u2013 \\u0435\\u0449\\u0451 \\u043e\\u0434\\u043d\\u043e \\u043f\\u0440\\u0435\\u0438\\u043c\\u0443\\u0449\\u0435\\u0441\\u0442\\u0432\\u043e \\u044d\\u0442\\u043e\\u0439 \\u043c\\u043e\\u0434\\u0435\\u043b\\u0438. \\u041e\\u043f\\u0442\\u0438\\u043c\\u0438\\u0437\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u043d\\u043e\\u0435 \\u044d\\u043d\\u0435\\u0440\\u0433\\u043e\\u043f\\u043e\\u0442\\u0440\\u0435\\u0431\\u043b\\u0435\\u043d\\u0438\\u0435 \\u0441\\u043d\\u0438\\u0436\\u0430\\u0435\\u0442 \\u043d\\u0430\\u0433\\u0440\\u0443\\u0437\\u043a\\u0443 \\u043d\\u0430 \\u0441\\u0438\\u0441\\u0442\\u0435\\u043c\\u0443 \\u0438 \\u0443\\u043c\\u0435\\u043d\\u044c\\u0448\\u0430\\u0435\\u0442 \\u0437\\u0430\\u0442\\u0440\\u0430\\u0442\\u044b \\u043d\\u0430 \\u044d\\u043a\\u0441\\u043f\\u043b\\u0443\\u0430\\u0442\\u0430\\u0446\\u0438\\u044e. \\u042d\\u0442\\u043e \\u0434\\u0435\\u043b\\u0430\\u0435\\u0442 Toshiba S300 Surveillance \\u044d\\u043a\\u043e\\u043d\\u043e\\u043c\\u0438\\u0447\\u043d\\u044b\\u043c \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435\\u043c \\u0434\\u043b\\u044f \\u043a\\u0440\\u0443\\u043f\\u043d\\u044b\\u0445 \\u0438 \\u043c\\u0430\\u043b\\u044b\\u0445 \\u0441\\u0438\\u0441\\u0442\\u0435\\u043c \\u0431\\u0435\\u0437\\u043e\\u043f\\u0430\\u0441\\u043d\\u043e\\u0441\\u0442\\u0438.  <br \\/>\\n<br \\/>\\n\\u0414\\u0438\\u0441\\u043a \\u0441\\u043e\\u0432\\u