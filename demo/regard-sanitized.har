u043e\\u0442\\u043a\\u0430\\u0437, \\u0437\\u0430\\u044f\\u0432\\u043b\\u0435\\u043d\\u043d\\u043e\\u0435 \\u043f\\u0440\\u043e\\u0438\\u0437\\u0432\\u043e\\u0434\\u0438\\u0442\\u0435\\u043b\\u0435\\u043c \\u043d\\u0430 \\u0443\\u0440\\u043e\\u0432\\u043d\\u0435 1 \\u043c\\u0438\\u043b\\u043b\\u0438\\u043e\\u043d\\u0430 \\u0447\\u0430\\u0441\\u043e\\u0432. \\u042d\\u0442\\u0430 \\u0434\\u043e\\u0441\\u0442\\u043e\\u0432\\u0435\\u0440\\u043d\\u0430\\u044f \\u0438\\u043d\\u0444\\u043e\\u0440\\u043c\\u0430\\u0446\\u0438\\u044f \\u043f\\u043e\\u0434\\u0447\\u0451\\u0440\\u043a\\u0438\\u0432\\u0430\\u0435\\u0442 \\u0432\\u044b\\u0441\\u043e\\u043a\\u0438\\u0439 \\u043a\\u043b\\u0430\\u0441\\u0441 \\u043d\\u0430\\u0434\\u0451\\u0436\\u043d\\u043e\\u0441\\u0442\\u0438 \\u0441\\u0435\\u0440\\u0438\\u0438 IronWolf, \\u043a\\u043e\\u0442\\u043e\\u0440\\u0430\\u044f \\u043f\\u0440\\u043e\\u0435\\u043a\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043b\\u0430\\u0441\\u044c \\u0432 \\u043b\\u0430\\u0431\\u043e\\u0440\\u0430\\u0442\\u043e\\u0440\\u0438\\u044f\\u0445 \\u0438\\u043d\\u0436\\u0435\\u043d\\u0435\\u0440\\u043e\\u0432 \\u0434\\u043b\\u044f \\u043d\\u0435\\u043f\\u0440\\u0435\\u0440\\u044b\\u0432\\u043d\\u043e\\u0433\\u043e \\u043e\\u0431\\u0441\\u043b\\u0443\\u0436\\u0438\\u0432\\u0430\\u043d\\u0438\\u044f \\u0437\\u0430\\u043f\\u0440\\u043e\\u0441\\u043e\\u0432. \\u0414\\u0430\\u0436\\u0435 \\u043f\\u0440\\u0438 \\u043f\\u043e\\u0432\\u044b\\u0448\\u0435\\u043d\\u043d\\u044b\\u0445 \\u0442\\u0435\\u043c\\u043f\\u0435\\u0440\\u0430\\u0442\\u0443\\u0440\\u043d\\u044b\\u0445 \\u0440\\u0435\\u0436\\u0438\\u043c\\u0430\\u0445 \\u0432\\u043d\\u0443\\u0442\\u0440\\u0438 \\u043e\\u0442\\u0441\\u0435\\u043a\\u0430 \\u0445\\u0440\\u0430\\u043d\\u0438\\u043b\\u0438\\u0449\\u0430, \\u043f\\u0440\\u0438 \\u0432\\u0438\\u0431\\u0440\\u0430\\u0446\\u0438\\u044f\\u0445 \\u043e\\u0442 \\u0441\\u043e\\u0441\\u0435\\u0434\\u043d\\u0438\\u0445 \\u0448\\u043f\\u0438\\u043d\\u0434\\u0435\\u043b\\u0435\\u0439 \\u043f\\u043b\\u0430\\u0441\\u0442\\u0438\\u043d\\u044b \\u043e\\u0441\\u0442\\u0430\\u044e\\u0442\\u0441\\u044f \\u0441\\u0442\\u0430\\u0431\\u0438\\u043b\\u044c\\u043d\\u044b\\u043c\\u0438.<br \\/>\\n<br \\/>\\n\\u041d\\u0435 \\u0437\\u0430\\u0431\\u044b\\u0442 \\u0438 \\u0432\\u0430\\u0436\\u043d\\u0435\\u0439\\u0448\\u0438\\u0439 \\u043a\\u043e\\u043c\\u043f\\u043e\\u043d\\u0435\\u043d\\u0442 \\u043b\\u044e\\u0431\\u043e\\u0433\\u043e \\u0441\\u043e\\u0432\\u0440\\u0435\\u043c\\u0435\\u043d\\u043d\\u043e\\u0433\\u043e \\u0432\\u0438\\u043d\\u0447\\u0435\\u0441\\u0442\\u0435\\u0440\\u0430 \\u2014 \\u043e\\u0431\\u044a\\u0451\\u043c \\u0431\\u0443\\u0444\\u0435\\u0440\\u043d\\u043e\\u0439 \\u043f\\u0430\\u043c\\u044f\\u0442\\u0438. \\u0417\\u0434\\u0435\\u0441\\u044c \\u043e\\u043d \\u0441\\u043e\\u0441\\u0442\\u0430\\u0432\\u043b\\u044f\\u0435\\u0442 \\u0432\\u043d\\u0443\\u0448\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u044b\\u0435 256 \\u043c\\u0435\\u0433\\u0430\\u0431\\u0430\\u0439\\u0442 \\u041a\\u042d\\u0428\\u0430. \\u0411\\u0443\\u0444\\u0435\\u0440\\u043d\\u0430\\u044f \\u043f\\u0430\\u043c\\u044f\\u0442\\u044c \\u0432\\u044b\\u043f\\u043e\\u043b\\u043d\\u044f\\u0435\\u0442 \\u0440\\u043e\\u043b\\u044c \\u043f\\u0440\\u043e\\u043c\\u0435\\u0436\\u0443\\u0442\\u043e\\u0447\\u043d\\u043e\\u0433\\u043e \\u0445\\u0440\\u0430\\u043d\\u0438\\u043b\\u0438\\u0449\\u0430 \\u0434\\u043b\\u044f \\u0443\\u0441\\u043a\\u043e\\u0440\\u0435\\u043d\\u0438\\u044f \\u043e\\u043f\\u0435\\u0440\\u0430\\u0446\\u0438\\u0439 \\u0447\\u0442\\u0435\\u043d\\u0438\\u044f \\u0438 \\u0437\\u0430\\u043f\\u0438\\u0441\\u0438 \\u043f\\u0440\\u0438 \\u0440\\u0430\\u0431\\u043e\\u0442\\u0435 \\u0441 \\u043c\\u0435\\u043b\\u043a\\u0438\\u043c\\u0438 \\u0438 \\u0441\\u0440\\u0435\\u0434\\u043d\\u0438\\u043c\\u0438 \\u0444\\u0430\\u0439\\u043b\\u0430\\u043c\\u0438. \\u0412 \\u043f\\u043e\\u0432\\u0441\\u0435\\u0434\\u043d\\u0435\\u0432\\u043d\\u043e\\u0439 \\u0434\\u043e