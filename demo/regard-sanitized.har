\u043d\\u043d\\u044b\\u0445. \\u0422\\u0435\\u0445\\u043d\\u043e\\u043b\\u043e\\u0433\\u0438\\u044f Seagate AcuTrac \\u043e\\u0431\\u0435\\u0441\\u043f\\u0435\\u0447\\u0438\\u0432\\u0430\\u0435\\u0442 \\u0441\\u0442\\u0430\\u0431\\u0438\\u043b\\u044c\\u043d\\u0443\\u044e \\u0440\\u0430\\u0431\\u043e\\u0442\\u0443 \\u0436\\u0435\\u0441\\u0442\\u043a\\u043e\\u0433\\u043e \\u0434\\u0438\\u0441\\u043a\\u0430 \\u0434\\u0430\\u0436\\u0435 \\u043f\\u0440\\u0438 \\u0432\\u044b\\u0441\\u043e\\u043a\\u0438\\u0445 \\u043d\\u0430\\u0433\\u0440\\u0443\\u0437\\u043a\\u0430\\u0445. \\u0411\\u043b\\u0430\\u0433\\u043e\\u0434\\u0430\\u0440\\u044f \\u0442\\u0435\\u0445\\u043d\\u043e\\u043b\\u043e\\u0433\\u0438\\u0438 Seagate OptiCache, \\u0443\\u0441\\u0442\\u0440\\u043e\\u0439\\u0441\\u0442\\u0432\\u043e \\u043e\\u0431\\u0435\\u0441\\u043f\\u0435\\u0447\\u0438\\u0432\\u0430\\u0435\\u0442 \\u0431\\u044b\\u0441\\u0442\\u0440\\u044b\\u0439 \\u0434\\u043e\\u0441\\u0442\\u0443\\u043f \\u043a \\u0434\\u0430\\u043d\\u043d\\u044b\\u043c \\u0438 \\u043f\\u043e\\u0432\\u044b\\u0448\\u0435\\u043d\\u043d\\u0443\\u044e \\u043f\\u0440\\u043e\\u0438\\u0437\\u0432\\u043e\\u0434\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u044c.<br \\/>\\n<br \\/>\\n\\u0416\\u0435\\u0441\\u0442\\u043a\\u0438\\u0439 \\u0434\\u0438\\u0441\\u043a Seagate Barracuda (ST4000DM004) \\u043e\\u0431\\u043b\\u0430\\u0434\\u0430\\u0435\\u0442 \\u0432\\u044b\\u0441\\u043e\\u043a\\u043e\\u0439 \\u044d\\u043d\\u0435\\u0440\\u0433\\u043e\\u044d\\u0444\\u0444\\u0435\\u043a\\u0442\\u0438\\u0432\\u043d\\u043e\\u0441\\u0442\\u044c\\u044e, \\u0447\\u0442\\u043e \\u043f\\u043e\\u0437\\u0432\\u043e\\u043b\\u044f\\u0435\\u0442 \\u0441\\u043d\\u0438\\u0437\\u0438\\u0442\\u044c \\u044d\\u043d\\u0435\\u0440\\u0433\\u043e\\u043f\\u043e\\u0442\\u0440\\u0435\\u0431\\u043b\\u0435\\u043d\\u0438\\u0435 \\u0438 \\u0443\\u043c\\u0435\\u043d\\u044c\\u0448\\u0438\\u0442\\u044c \\u0442\\u0435\\u043f\\u043b\\u043e\\u0432\\u044b\\u0434