ination-widget__page-link\">2</a></li><li\n\t\t\t\tclass            = \"pagination-widget__page \"\n\t\t\t\tdata-role        = \"pagination-page\"\n\t\t\t\tdata-page-number = \"3\"\n\t\t\t><a href=\"/catalog/17a8914916404e77/zestkie-diski-35/?p=3\" class=\"pagination-widget__page-link\">3</a></li><li\n\t\t\t\tclass            = \"pagination-widget__page \"\n\t\t\t\tdata-role        = \"pagination-page\"\n\t\t\t\tdata-page-number = \"4\"\n\t\t\t><a href=\"/catalog/17a8914916404e77/zestkie-diski-35/?p=4\" class=\"pagination-widget__page-link\">4</a></li><li\n\t\t\t\tclass            = \"pagination-widget__page \"\n\t\t\t\tdata-role        = \"pagination-page\"\n\t\t\t\tdata-page-number = \"5\"\n\t\t\t><a href=\"/catalog/17a8914916404e77/zestkie-diski-35/?p=5\" class=\"pagination-widget__page-link\">5</a></li><li\n\t\t\t\tclass            = \"pagination-widget__page \"\n\t\t\t\tdata-role        = \"pagination-page\"\n\t\t\t\tdata-page-number = \"6\"\n\t\t\t><a href=\"/catalog/17a8914916404e77/zestkie-diski-35/?p=6\" class=\"pagination-widget__page-link\">6</a></li><li\n\t\t\t\tclass            = \"pagination-widget__page \"\n\t\t\t\tdata-role        = \"pagination-page\"\n\t\t\t\tdata-page-number = \"7\"\n\t\t\t><a href=\"/catalog/17a8914916404e77/zestkie-diski-35/?p=7\" class=\"pagination-widget__page-link\">7</a></li><li\n\t\t\t\tclass            = \"pagination-widget__page\"\n\t\t\t\tdata-role        = \"pagination-page\"\n\t\t\t\tdata-page-number = \"2\"\n\t\t\t><a\n\t\t\t\t\thref  = \"/catalog/17a8914916404e77/zestkie-diski-35/?p=2\"\n\t\t\t\t\tclass = \"pagination-widget__page-link pagination-widget__page-link_next \"\n\t\t\t\t></a></li><li\n\t\t\t\tclass            = \"pagination-widget__page\"\n\t\t\t\tdata-role        = \"pagination-page\"\n\t\t\t\tdata-page-number = \"7\"\n\t\t\t><a\n\t\t\t\t\thref  = \"/catalog/17a8914916404e77/zestkie-diski-35/?p=7\"\n\t\t\t\t\tclass = \"pagination-widget__page-link pagination-widget__page-link_last \"\n\t\t\t\t></a></li></ul></div></div></div></div></div></div><div class=\"products-page__helpers products-page__helpers_mobile\"><span id=\"as-hNYCzX\"></span></div><span id=\"as-GS0cMj\" class=\"viewed-products-slider\"></span><div class=\"spoiler-text-description spoiler-text-description_layer\" data-role=\"spoiler-text-description\"><div class=\"spoiler-text-description__content\">\n\t\tЖесткие диски 3.5\" в основном используются для комплектации стационарных компьютеров (в том числе – серверов). Соответствующие 3.5-дюймовому форм-фактору дисковые накопители обладают совместимостью и с другими устройствами, например – с сетевыми хранилищами и регистраторами для систем видеонаблюдения. Вы сможете использовать HDD очень большого объема. Именно вместительность является главным преимуществом жестких дисков перед твердотельными конкурентами. Преимуществом перед SSD является и способность HDD выдерживать фактически неограниченное количество циклов записи. В силу особенностей SSD-устройств ресурс циклов записи ограничен.\r\nВыбор жестких дисков 3.5\" зависит от типа задачи, которую вы хотите решить. Для комплектации серверов следует использовать модели с интерфейсом SAS, главным преимуществом которого является поддержка технологии Multipath. SAS-диски станут отличным вариантом для построения отказоустойчивой дисковой подсистемы. Наиболее распространены жесткие диски 3.5\" с интерфейсом SATA. Производительность любых HDD выражается в показателе максимальной скорости передачи данных. При оценке необходимого вам объема жесткого диска следует закладывать запас минимум на несколько десятков процентов, а то и в разы. Если вы будете использовать несколько HDD, то вам наверняка будет полезна оптимизация HDD под RAID-массивы.\r\nВ интернет-магазине DNS всегда представлен широкий ассортимент жестких дисков 3.5\". Мы предлагаем продукцию всех ведущих производителей в этой области. Вы наверняка сможете выбрать необходимый вам HDD.\t</div><a class=\"spoiler-text-description__toggle ui-link ui-link_blue\" data-toggle><i class=\"spoiler-text-description__toggle-icon\"></i></a></div><div class=\"virtual-categories-list\" data-seo-virtual-categories=\"/catalog/category/get-virtual-categories-list/?guid=17a89149-1640-11e5-a679-00259074e77d\"></div></div></div><div id=\"feedback-modal\"></div><span id=\"as-EXejvG\" style=\"background:#333;display:block;min-height:300px;margin-top:30px;\"></span><div id=\"bodyLoader\" class=\"body-loader\"><div class=\"loader\"><div class=\"animation animation_active\"><div class=\"animation__scene\"><div class=\"animation__scene\"><div class=\"animation__ufo\"><svg version=\"1.1\" xmlns=\"http://www.w3.org/2000/svg\" x=\"0px\" y=\"0px\"\n\t\t\t\t\t\t     viewBox=\"0 0 740.4 412.1\" style=\"enable-background:new 0 0 740.4 412.1;\" xml:space=\"preserve\"><g class=\"l2\"><path d=\"M158.3,312.7c-0.7-5.1-4.6-8-9.7-7.2s-8,4.6-7.2,9.7c0.7,5.1,4.6,8,9.7,7.2S159.1,317.8,158.3,312.7z\"/><path d=\"M200.6,306.7c-0.7-5.1-4.6-8-9.7-7.2l-8.4,1.2c-5.1,0.7-8,4.6-7.2,9.7s4.6,8,9.7,7.2l8.4-1.2C198.4,315.6,201.3,311.8,200.6,306.7z\"/><path d=\"M124.6,317.5c-0.7-5.1-4.6-8-9.7-7.2l-98.1,15.9c-5.1,0.7-8,4.6-7.2,9.7c0.7,5.1,4.6,8,9.7,7.2l98.1-15.9C122.4,326.5,125.3,322.6,124.6,317.5z\"/></g><g class=\"l1\"><path d=\"M275.4,346.6c-0.7-5.1-4.6-8-9.7-7.2l-16.9,2.4c-5.1,0.7-8,4.6-7.2,9.7c0.7,5.1,4.6,8,9.7,7.2l16.9-2.4C273.3,355.5,276.2,351.7,275.4,346.6z\"/><path d=\"M224.7,353.8c-0.7-5.1-4.6-8-9.7-7.2l-78.2,12.1c-5.1,0.7-8,4.6-7.2,9.7c0.7,5.1,4.6,8,9.7,7.2l78.2-12.1C222.6,362.8,225.5,358.9,224.7,353.8z\"/></g><g class=\"l3\"><path d=\"M142.7,263.2c-0.7-5.1-4.6-8-9.7-7.2l-77.2,12.1c-5.1,0.7-8,4.6-7.2,9.7c0.7,5.1,4.6,8,9.7,7.2l77.2-12.1C140.5,272.2,143.4,268.3,142.7,263.2z\"/><path d=\"M201.8,254.8c-0.7-5.1-4.6-8-9.7-7.2l-25.3,3.6c-5.1,0.7-8,4.6-7.2,9.7c0.7,5.1,4.6,8,9.7,7.2l25.3-3.6C199.6,263.7,202.5,259.9,201.8,254.8z\"/></g><g><path class=\"st0\" d=\"M484.1,100.9c-4.9,0-8.8-4-8.8-9V47.1c0-5,3.9-9,8.8-9c4.9,0,8.8,4,8.8,9v44.8C492.9,96.9,489,100.9,484.1,100.9\"/><g